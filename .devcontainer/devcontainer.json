{
  "name": "market-signal-elt",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "hostRequirements": {"cpus": 4, "memory": "16gb"},
  "postCreateCommand": "pip install -r requirements.txt && cp -n .env.example .env && python -m msp.pipeline run --sample",
  "forwardPorts": [8501, 8080],
  "portsAttributes": {
    "8501": {"label": "Dashboard", "onAutoForward": "openBrowser"},
    "8080": {"label": "Airflow"}
  },
  "customizations": {"vscode": {"extensions": ["ms-python.python"]}}
}
