# Copy to .env and fill in. Every key is optional: missing keys fall back gracefully.

# Gemini (free key: https://aistudio.google.com) - signal synthesis and the judge
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Finnhub (free key: https://finnhub.io/register) - company news and earnings estimates
FINNHUB_API_KEY=
# FRED (free key: https://fred.stlouisfed.org/docs/api/api_key.html) - optional, keyless CSV is used otherwise
FRED_API_KEY=
# SEC asks for a descriptive User-Agent with a contact email
SEC_USER_AGENT=market-signal-elt research demo your-email@example.com

# auto = live APIs with per-source fallback to the bundled sample; sample = sample only; live = fail if a source is down
DATA_MODE=auto
# auto = Llama for bulk, Gemini for reasoning; or ollama, gemini, offline
LLM_PROVIDER=auto
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Leave empty for the SQLite quick demo. docker compose sets Postgres automatically.
# DATABASE_URL=postgresql+psycopg2://msp:msp@localhost:5432/warehouse

# docker compose only: your user id so containers can write ./data (run: id -u)
AIRFLOW_UID=1000
