FROM apache/airflow:2.10.5-python3.11

# Pipeline dependencies go in their own virtualenv so they never clash with Airflow's
# pinned packages. DAG tasks run there via ExternalPythonOperator (MSP_PYTHON).
USER root
RUN python -m venv /opt/msp-venv && chown -R airflow: /opt/msp-venv
USER airflow
COPY requirements.txt /tmp/requirements.txt
RUN /opt/msp-venv/bin/pip install --no-cache-dir -r /tmp/requirements.txt
ENV MSP_PYTHON=/opt/msp-venv/bin/python \
    PYTHONPATH=/opt/airflow/project
